APP_NAME="Busy Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=busy_hub
DB_USERNAME=busyhub
DB_PASSWORD=

# IPs/CIDRs of proxies allowed to set X-Forwarded-* headers. This is the
# pinned address of the Caddy container on the compose network (see
# docker-compose.prod.yml). Keep the two in sync. If a CDN or load balancer is
# added in front of Caddy, add its ranges here AND to Caddy's trusted_proxies.
TRUSTED_PROXIES=172.28.0.10

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Sessions, cache and queue all use the database. No Redis service is needed.

# Default: any SMTP provider (e.g. Brevo). Resend also works over SMTP with
# MAIL_HOST=smtp.resend.com, MAIL_PORT=587, MAIL_USERNAME=resend and the API
# key as MAIL_PASSWORD; no Composer SDK is required.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=
RESEND_API_KEY=
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxx

MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_NUMBER=
