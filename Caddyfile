# Production Caddyfile — automatic HTTPS for a public APP_URL.
# Behind a CDN or external load balancer, add a `trusted_proxies` block with
# that proxy's IP/CIDR so Caddy preserves the real client IP in X-Forwarded-For.
{$APP_URL:localhost} {
    encode zstd gzip

    # Static root lives in this image (public/ is baked in). File checks
    # (try_files) run against it; PHP itself is executed by the app container.
    root * /srv/public

    # No matcher: Caddy rewrites unknown paths to index.php, executes *.php
    # through FPM, and leaves real files to file_server. `root` inside the
    # block is the SCRIPT_FILENAME root used by the PHP-FPM container.
    php_fastcgi app:9000 {
        root /var/www/html/public
    }

    file_server

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }

    log {
        output stdout
    }
}
